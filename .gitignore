/target

# Coverage instrumentation output (llvm source-based coverage).
*.profraw
*.profdata
/target/coverage-report

# Python bytecode cache from the e2e harness.
__pycache__/

# Generated TLS material; run `certs/gen.sh` to (re)create it locally.
# Never commit private keys; the daemon and tests generate their own.
/certs/*.crt
/certs/*.key
/certs/*.pem
